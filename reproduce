def list_tables():
    print(__doc__.split("\n")[0])
    print("\navailable tables:\n")
    for (plat, name), t in TABLES.items():
        print(f"  ./reproduce {plat} {name}")
        print(f"      {t['desc']}")
    print("\npins: environment.lock.json · fairness: methodology/fairness-rules.md")
    print("forward-looking runs (standing matrix / release regression): ./bench — this "
          "registry stays published-tables-only")


def check_prereq(label, path):
    if path == "@MODEL":
        p = os.environ.get("MODEL", DEFAULT_E2B)
        ok = os.path.exists(p)
        return ok, f"{label}: {'OK  ' + p if ok else 'MISSING — set ' + E2B_MODEL_HINT}"
    p = os.path.expanduser(path)
    if not os.path.isabs(p):
        p = os.path.join(ROOT, p)
    return os.path.exists(p), f"{label}: {'OK' if os.path.exists(p) else 'MISSING (' + path + ')'}"


def show(plat, name, t):
    print(f"# {plat} / {name}\n{t['desc']}")
    print(f"published: {t['published']}")
    print(f"rows:      {t['rows']}")
    print("prereqs:")
    all_ok = True
    for label, path in t["prereqs"]:
        ok, line = check_prereq(label, path)
        all_ok &= ok
        print(f"  [{'x' if ok else ' '}] {line}")
    print("commands (from repo root):")
    for c in t["commands"]:
        print(f"  {c}")
    if t.get("notes"):
        print(f"note: {t['notes']}")
    if t["mode"] == "exec":
        print("\n--run executes the command list above in order (MODEL env selects the model).")
    else:
        print("\n--run <args...> forwards to the protocol script (its own staging applies).")
    return all_ok


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("list", "-h", "--help"):
        list_tables()
        return 0
    if len(args) < 2 or (args[0], args[1]) not in TABLES:
        print(f"unknown table: {' '.join(args[:2])}\n", file=sys.stderr)
        list_tables()
        return 2
    plat, name = args[0], args[1]
    t = TABLES[(plat, name)]
    run = len(args) > 2 and args[2] == "--run"
    regress = len(args) > 2 and args[2] == "--regress"
    ok = show(plat, name, t)
    if not (run or regress):
        return 0
    if not ok:
        print(f"\nrefusing {args[2]}: prerequisites missing (see above)", file=sys.stderr)
        return 1
    os.chdir(ROOT)
    if regress and t["mode"] != "exec":
        print("\n--regress only drives exec-style tables; device tables are staged "
              "captures — run the protocol script, then diff the campaigns with\n"
              "  python3 scripts/regression_diff.py device --baseline campaign:<old> "
              "--candidate campaign:<new>", file=sys.stderr)
        return 2
    if t["mode"] == "exec":
        env = dict(os.environ, MODEL=os.environ.get("MODEL", DEFAULT_E2B))
        if regress:
            outdir = os.path.join("results", "quality", "regression",
                                  f"{time.strftime('%Y-%m-%d', time.gmtime())}-{name}")
            env["GSM8K_REPORTS"] = outdir
            print(f"\nregression capture -> {outdir} (published reports stay untouched)")
        for c in t["commands"]:
            print(f"\n>>> {c}", flush=True)
            r = subprocess.run(["bash", "-c", c], env=env)
            if r.returncode != 0:
                print(f"command failed ({r.returncode}); stopping", file=sys.stderr)
                return r.returncode
        if regress:
            cmd = [sys.executable, "scripts/regression_diff.py", "quality",
                   "--candidate-dir", outdir]
            print(f"\n>>> {' '.join(cmd)}", flush=True)
            return subprocess.run(cmd).returncode
        return 0
    extra = args[3:]
    if not extra:
        print("\nthis entry forwards to its protocol script — pass its subcommand after --run",
              file=sys.stderr)
        return 2
    cmd = [t["script"]] + extra
    print(f"\n>>> {' '.join(cmd)}", flush=True)
    return subprocess.run(cmd).returncode


if __name__ == "__main__":
    sys.exit(main())
