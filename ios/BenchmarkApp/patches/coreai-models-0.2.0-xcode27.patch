         .package(url: "https://github.com/huggingface/swift-transformers", from: "1.1.0"),
-        .package(url: "https://github.com/mlc-ai/xgrammar", branch: "main"),
+        .package(url: "https://github.com/mlc-ai/xgrammar", exact: "0.2.9"),
